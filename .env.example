JWT_SECRET=replace-with-a-long-random-value
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/github/callback

# CI stays disabled until infrastructure is ready and its real test is authorized.
ATLAS_CI_ENABLED=false
ATLAS_CI_MODE=central
ATLAS_CI_CENTRAL_READY=false
WOODPECKER_URL=https://wood.atlasfy.site
WOODPECKER_TOKEN=
WOODPECKER_EXPECTED_AUTHOR=
ATLAS_CI_AUTHORIZATION_TOKEN=
ATLAS_REGISTRY_URL=https://10.10.10.10:5000
ATLAS_REGISTRY_NAMESPACE=atlas
# Read-only Registry credentials. Choose Basic OR a pre-issued Bearer token.
ATLAS_REGISTRY_USERNAME=
ATLAS_REGISTRY_PASSWORD=
ATLAS_REGISTRY_TOKEN=
# PEM path INSIDE the backend container. Mount the public CA read-only separately.
ATLAS_REGISTRY_CA_FILE=
ATLAS_CI_HTTP_TIMEOUT_SECONDS=15
ATLAS_CI_POLL_SECONDS=5
ATLAS_CI_RUN_TIMEOUT_SECONDS=3600
# Optional pilot only; full canonical GitHub URL, never a general authorization list.
ATLAS_CI_TEST_REPOSITORY=

# External secrets: set VALUE or VALUE_FILE, never both. Paths are inside the container.
# See compose.ci-secrets.yaml for read-only external mounts; no secrets are committed.
WOODPECKER_TOKEN_FILE=
ATLAS_CI_AUTHORIZATION_TOKEN_FILE=
ATLAS_CI_PUBLICATION_TOKEN=
ATLAS_CI_PUBLICATION_TOKEN_FILE=
ATLAS_REGISTRY_PASSWORD_FILE=
ATLAS_REGISTRY_TOKEN_FILE=
