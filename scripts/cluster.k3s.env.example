# Values for the runner. Load into its environment; no credentials in this file.
ATLAS_IMAGE_DELIVERY=registry
ATLAS_KUBE_CONTEXT=your-k3s-context
ATLAS_BUILD_PLATFORM=linux/arm64
# The Kubero operator packages source; this selects its native automatic builder.
ATLAS_KUBERO_BUILD_STRATEGY=buildpacks
ATLAS_KUBERO_CNB_BUILDER=paketobuildpacks/ubuntu-noble-builder:latest
ATLAS_KUBERO_BUILD_TIMEOUT_MINUTES=30
# Secret with .dockerconfigjson in namespace kubero (default: registry-login).
ATLAS_KUBERO_REGISTRY_SECRET=registry-login
ATLAS_IMAGE_REGISTRY=registry.example.edu/atlas
ATLAS_DOMAIN_SUFFIX=apps.example.edu
ATLAS_INGRESS_CLASS=traefik
# Optional: create this Kubernetes secret separately in atlas-production.
ATLAS_IMAGE_PULL_SECRET=
# Select the installed storage class after inspecting the real cluster.
ATLAS_STORAGE_CLASS=
ATLAS_POSTGRES_STORAGE=1Gi

# Used by Compose; the runner also needs KUBECONFIG pointing to this file.
ATLAS_KUBECONFIG_FILE=./.local/k3s.kubeconfig
